root = true
[*.cs]

insert_final_newline = true
# Matches .gitattributes, which stores and checks out *.cs as LF. Without this,
# dotnet format rewrites files with CRLF on Windows.
end_of_line = lf

# Style diagnostics are warnings, not errors: they are enforced at build time (see
# Directory.Build.props) and promoting every cosmetic preference to build-breaking would rank a
# stale #pragma the same as real dead code. Promote individual rules to error once their count
# reaches zero.
dotnet_analyzer_diagnostic.category-Style.severity = warning

# Here we ignore some rule violations that they are not really important for us
dotnet_diagnostic.IDE0008.severity = silent # Explicit type, not var
dotnet_diagnostic.IDE0011.severity = silent # Add braces
dotnet_diagnostic.IDE0044.severity = warning # Add readonly modifier
dotnet_diagnostic.IDE0090.severity = silent # Use implicit new
dotnet_diagnostic.IDE0300.severity = silent # Use collection expression for array
dotnet_diagnostic.IDE0301.severity = silent # Use collection expression for empty
dotnet_diagnostic.IDE0305.severity = silent # Use collection expression for fluent
dotnet_diagnostic.IDE0028.severity = silent # Collection initialization can be simplified
dotnet_diagnostic.IDE0306.severity = silent # Use collection expression for new
dotnet_diagnostic.IDE0057.severity = silent # Use range operator
dotnet_diagnostic.IDE0058.severity = silent # Expression value is never used
dotnet_diagnostic.IDE0290.severity = silent # Use primary constructor
dotnet_diagnostic.IDE0010.severity = silent # Add missing cases to switch
dotnet_diagnostic.IDE0046.severity = silent # Use conditional expression for return
dotnet_diagnostic.IDE0130.severity = silent # Namespace does not match folder structure
dotnet_diagnostic.IDE0072.severity = silent
dotnet_diagnostic.IDE0010.severity = silent

# https://github.com/dotnet/aspnetcore/issues/47912
dotnet_diagnostic.IDE0005.severity = none # Remove unnecessary using directives (using CS8019 instead)
dotnet_diagnostic.CS8019.severity = error # Remove unnecessary using directives

dotnet_diagnostic.CA1823.severity = error # Avoid unused private fields
dotnet_diagnostic.IDE0052.severity = error # Remove unread private members (count is zero; keep it there)

# CA1801/CA1804/CA1811 are legacy FxCop rules that no longer ship in the .NET analyzers; setting
# their severity here did nothing. The live equivalents are IDE0060 (unused parameters), IDE0059
# (unused locals), and IDE0051 (uncalled private code), which run via EnforceCodeStyleInBuild.

# Expression bodies are preferred only where the member fits on a single line; anything that needs
# to wrap gets a block body. The C# defaults disagree with the codebase here (they prefer block
# bodies for methods and expression bodies for properties regardless of length).
#
# These are a preference, not a mandate: the diagnostics are silenced below. The tree holds both
# styles (~71 expression-bodied methods, ~229 single-statement block-bodied ones), so enforcing
# either direction would churn hundreds of methods for no behavioral gain. Write new code in this
# style; leave existing code alone.
dotnet_diagnostic.IDE0021.severity = silent # Use expression body for constructor
dotnet_diagnostic.IDE0022.severity = silent # Use expression body for method
dotnet_diagnostic.IDE0025.severity = silent # Use expression body for property
dotnet_diagnostic.IDE0027.severity = silent # Use expression body for accessor
dotnet_diagnostic.IDE0061.severity = silent # Use expression body for local function

csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_constructors = when_on_single_line
csharp_style_expression_bodied_operators = when_on_single_line
csharp_style_expression_bodied_local_functions = when_on_single_line
csharp_style_expression_bodied_properties = when_on_single_line
csharp_style_expression_bodied_indexers = when_on_single_line
csharp_style_expression_bodied_accessors = when_on_single_line

# Microsoft .NET properties
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_open_brace = all
csharp_preferred_modifier_order = private, protected, internal, async, file, public, override, sealed, virtual, static, abstract, readonly, extern, unsafe, volatile, new, required:suggestion
csharp_preserve_single_line_blocks = true
csharp_style_var_elsewhere = false:none
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:none
csharp_using_directive_placement = outside_namespace
csharp_style_namespace_declarations = file_scoped
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:none
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:none
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary:none

# ReSharper properties
resharper_align_linq_query = true
resharper_align_multiline_binary_expressions_chain = false
resharper_align_multiline_parameter = true
resharper_blank_lines_after_block_statements = 0
resharper_blank_lines_after_start_comment = 0
resharper_blank_lines_around_auto_property = 0
resharper_blank_lines_around_property = 0
resharper_braces_for_foreach = not_required
resharper_braces_for_ifelse = not_required
resharper_braces_redundant = false
resharper_csharp_blank_lines_around_field = 0
resharper_csharp_blank_lines_around_invocable = 0
resharper_csharp_blank_lines_around_region = 0
resharper_csharp_case_block_braces = next_line_shifted_2
resharper_csharp_insert_final_newline = true
resharper_csharp_keep_blank_lines_in_declarations = 100
resharper_csharp_keep_existing_enum_arrangement = false
resharper_csharp_max_line_length = 100
resharper_csharp_remove_blank_lines_near_braces_in_code = false
resharper_csharp_remove_blank_lines_near_braces_in_declarations = false
resharper_empty_string = string_empty
resharper_instance_members_qualify_declared_in = 
resharper_object_creation_when_type_evident = explicitly_typed
resharper_outdent_statement_labels = true
resharper_parentheses_redundancy_style = remove
resharper_parentheses_same_type_operations = true
resharper_place_accessorholder_attribute_on_same_line = false
resharper_place_expr_accessor_on_single_line = true
resharper_place_expr_property_on_single_line = true
resharper_place_simple_embedded_statement_on_same_line = false
resharper_place_simple_initializer_on_single_line = false
resharper_trailing_comma_in_multiline_lists = false
resharper_wrap_before_arrow_with_expressions = true
resharper_wrap_object_and_collection_initializer_style = chop_always

# Naming: private instance fields use _camelCase; private static/const fields stay PascalCase.
# Kept at warning (not error) so the legacy FlamingIRC socket subsystem, which still uses a
# bare-camelCase convention, does not break the build before it is migrated.
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.private_const_fields_pascal.severity = warning
dotnet_naming_rule.private_const_fields_pascal.symbols = private_const_fields
dotnet_naming_rule.private_const_fields_pascal.style = pascal_case
dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const

dotnet_naming_rule.private_static_fields_pascal.severity = warning
dotnet_naming_rule.private_static_fields_pascal.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_pascal.style = pascal_case
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
