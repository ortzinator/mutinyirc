<Project>

  <PropertyGroup>
    <!--
      Without this, every IDE#### severity in .editorconfig is inert during `dotnet build` and
      applies only in the IDE and under `dotnet format`. Turning it on is what makes the declared
      style rules real, including IDE0051/IDE0059/IDE0060, which replace the long-dead
      CA1801/CA1804/CA1811 settings.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      The compiler reports unused usings (CS8019) only when it parses doc comments, because a
      using can be necessary only for a cref. Without this, the CS8019 error in .editorconfig
      does not apply to `dotnet build`. See https://github.com/dotnet/roslyn/issues/41640.
      CS1591 (no XML comment on a public member) is off: this setting is for CS8019 only.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>