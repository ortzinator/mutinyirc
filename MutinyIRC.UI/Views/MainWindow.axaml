<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MutinyIRC.UI.ViewModels"
        xmlns:views="clr-namespace:MutinyIRC.UI.Views"
        xmlns:design="clr-namespace:MutinyIRC.UI.ViewModels.Design"
        xmlns:ic="using:FluentIcons.Avalonia"
        mc:Ignorable="d"
        x:Class="MutinyIRC.UI.Views.MainWindow"
        Title="MutinyIRC" Height="700" Width="1100" MinWidth="600" MinHeight="400"
        Background="{DynamicResource SidebarBackground}">

    <Design.DataContext>
        <design:DesignMainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <ControlTheme x:Key="SidebarNavTheme" TargetType="Button">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="Foreground"                Value="{DynamicResource SidebarMutedForeground}"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="HorizontalAlignment"       Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
            <Setter Property="CornerRadius"              Value="4"/>
            <Setter Property="Padding"                   Value="8,5"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBackground}"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBackground}"/>
            </Style>
            <Style Selector="^.active /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBackground}"/>
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource SidebarForeground}"/>
            </Style>
            <Style Selector="^.active">
                <Setter Property="Foreground" Value="{DynamicResource SidebarHeaderForeground}"/>
            </Style>
            <!-- Bold the nav item's text on unread. Set on the button so its content
                 TextBlocks inherit FontWeight, the same way they inherit Foreground —
                 a ControlTheme may not use a descendant selector to reach content. -->
            <Style Selector="^.unread">
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="150" MaxWidth="500"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Sidebar ═══ -->
        <DockPanel Grid.Column="0" Background="{DynamicResource SidebarBackground}">

            <!-- App header row -->
            <Border DockPanel.Dock="Top" Height="48"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource SidebarBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="14,0,8,0">
                    <TextBlock Text="MutinyIRC"
                               FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SidebarHeaderForeground}"/>
                    <Button Theme="{StaticResource SidebarNavTheme}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="6" CornerRadius="20"
                            ToolTip.Tip="Settings">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Settings..." Click="AppSettingsMenuItem_Click"/>
                                <MenuItem Header="Servers..." Click="ServersMenuItem_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                        <ic:SymbolIcon Symbol="Settings" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Server / channel tree -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Servers}" Margin="6,6,6,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ServerViewModel}">
                            <StackPanel>
                                <!-- Server entry -->
                                <Button Theme="{StaticResource SidebarNavTheme}"
                                        Classes.active="{Binding IsSelected}"
                                        Classes.unread="{Binding HasUnread}"
                                        Command="{Binding $parent[Window].DataContext.SelectPanelCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="8,6" Margin="0,1,0,0">
                                    <Button.Styles>
                                        <!-- The server name is SemiBold by default; a local FontWeight
                                             would block the theme's inherited Bold, so drive both weights
                                             from the unread class on the named element instead. -->
                                        <Style Selector="Button TextBlock#serverName">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                        <Style Selector="Button.unread TextBlock#serverName">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="ChevronRight" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SidebarMutedForeground}"/>
                                        <TextBlock x:Name="serverName"
                                                   Text="{Binding Name}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="(away)" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsAway}"
                                                   Foreground="{DynamicResource SidebarMutedForeground}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Channels under this server -->
                                <ItemsControl ItemsSource="{Binding Channels}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ChannelViewModel}">
                                            <Button Theme="{StaticResource SidebarNavTheme}"
                                                    Classes.active="{Binding IsSelected}"
                                                    Classes.unread="{Binding HasUnread}"
                                                    Command="{Binding $parent[Window].DataContext.SelectPanelCommand}"
                                                    CommandParameter="{Binding}"
                                                    Padding="20,4,8,4" Margin="0,1,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <ic:SymbolIcon Symbol="NumberSymbol" FontSize="13" Opacity="0.5"
                                                                   VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ChannelName}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Private messages under this server -->
                                <ItemsControl ItemsSource="{Binding PrivateMessages}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PrivateMessageViewModel}">
                                            <Grid Margin="0,1,0,0">
                                                <Grid.Styles>
                                                    <Style Selector="Button.closePm">
                                                        <Setter Property="Opacity" Value="0"/>
                                                    </Style>
                                                    <Style Selector="Grid:pointerover > Button.closePm">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </Style>
                                                </Grid.Styles>
                                                <Button Theme="{StaticResource SidebarNavTheme}"
                                                        Classes.active="{Binding IsSelected}"
                                                        Classes.unread="{Binding HasUnread}"
                                                        Command="{Binding $parent[Window].DataContext.SelectPanelCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="20,4,28,4">
                                                    <TextBlock Text="{Binding OtherNick}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </Button>
                                                <Button Classes="closePm"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Width="18" Height="18" Padding="0"
                                                        Margin="0,0,4,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        CornerRadius="3"
                                                        Foreground="{DynamicResource SidebarMutedForeground}"
                                                        Command="{Binding CloseCommand}"
                                                        ToolTip.Tip="Close">
                                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="11"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ═══ Sidebar resize handle ═══ -->
        <!-- A 1px hairline marks the divider; the transparent GridSplitter overlays
             it to provide a wider, easier-to-grab drag target. The Fluent GridSplitter
             template only renders Background, so the hairline is a separate Border. -->
        <Border Grid.Column="1" Width="1"
                HorizontalAlignment="Center"
                Background="{DynamicResource SidebarBorderBrush}"/>
        <GridSplitter Grid.Column="1" Width="4"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Center"/>

        <!-- ═══ Content area ═══ -->
        <ContentControl Grid.Column="2" Content="{Binding SelectedPanel}"
                        Background="{DynamicResource AppBackground}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="{x:Type vm:ChannelViewModel}">
                    <views:ChannelView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:PrivateMessageViewModel}">
                    <views:PrivateMessageView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ServerViewModel}">
                    <views:ServerView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

    </Grid>

</Window>
