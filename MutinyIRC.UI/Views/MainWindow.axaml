<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MutinyIRC.UI.ViewModels"
        xmlns:views="clr-namespace:MutinyIRC.UI.Views"
        xmlns:design="clr-namespace:MutinyIRC.UI.ViewModels.Design"
        mc:Ignorable="d"
        x:Class="MutinyIRC.UI.Views.MainWindow"
        Title="MutinyIRC" Height="700" Width="1100" MinWidth="600" MinHeight="400"
        Background="{DynamicResource SurfaceNav}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="48">

    <Design.DataContext>
        <design:DesignMainViewModel />
    </Design.DataContext>

    <!-- The client area runs edge to edge under the window decorations, so the root
         grid pulls in by OffScreenMargin. That margin is non-zero only when maximized
         on Windows, where the frame border sits outside the visible screen area. -->
    <Grid Margin="{Binding $parent[Window].OffScreenMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="150" MaxWidth="500"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <views:SidebarView Grid.Column="0"/>

        <!-- ═══ Sidebar resize handle ═══ -->
        <!-- A 1px hairline marks the divider; the transparent GridSplitter overlays
             it to provide a wider, easier-to-grab drag target. The Fluent GridSplitter
             template only renders Background, so the hairline is a separate Border. -->
        <Border Grid.Column="1" Width="1"
                HorizontalAlignment="Center"
                Background="{DynamicResource DividerBrush}"/>
        <GridSplitter Grid.Column="1" Width="4"
                      Background="Transparent"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Center"/>

        <!-- ═══ Content area ═══ -->
        <ContentControl Grid.Column="2" Content="{Binding SelectedPanel}"
                        Background="{DynamicResource SurfaceContent}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="{x:Type vm:ChannelViewModel}">
                    <views:ChannelView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:PrivateMessageViewModel}">
                    <views:PrivateMessageView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:ServerViewModel}">
                    <views:ServerView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

    </Grid>

</Window>
