<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MutinyIRC.UI.Controls"
             xmlns:conv="clr-namespace:MutinyIRC.UI.Converters"
             xmlns:views="clr-namespace:MutinyIRC.UI.Views"
             xmlns:vm="clr-namespace:MutinyIRC.UI.ViewModels"
             xmlns:design="clr-namespace:MutinyIRC.UI.ViewModels.Design"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d"
             x:Class="MutinyIRC.UI.Views.ChannelView"
             x:Name="channelPanel"
             Background="{DynamicResource SurfaceContent}">

    <Design.DataContext>
        <design:DesignChannelViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <conv:ModeToBrushConverter x:Key="ModeToBrushConverter" />
        <!-- App.axaml declares one of these too, but the view keeps its own so it resolves when
             hosted without the full application (design preview, headless tests). -->
        <conv:NickColorConverter x:Key="NickColorConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- The filter box draws its own rounded frame, so strip the one the Fluent TextBox
             template paints (including the focus underline it swaps in). -->
        <Style Selector="TextBox#userFilterBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- ── Channel header ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceLayer}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="{DynamicResource PanelHeaderPadding}" Height="48">
            <DockPanel VerticalAlignment="Center">
                <!-- User count badge (right side) -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                    <ic:SymbolIcon Symbol="People" FontSize="14" VerticalAlignment="Center" Opacity="0.6"/>
                    <TextBlock Text="{Binding UserList.Count}"
                               FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiary}"/>
                </StackPanel>
                <!-- Channel name -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="NumberSymbol" FontSize="18" Opacity="0.4" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ChannelName}"
                               FontWeight="SemiBold" FontSize="15"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Topic strip (hides itself when empty; click to expand the full topic) ── -->
        <local:TopicBar DockPanel.Dock="Top" Topic="{Binding Topic}"/>

        <!-- ── Message input bar ── -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceLayerAlt}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <Border Grid.Column="0"
                        Background="{DynamicResource InputBackground}"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        Padding="4,0">
                    <local:CommandTextBox x:Name="commandBox"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          PlaceholderText="Message..."
                                          FontSize="14"
                                          VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="sendButton"
                        Grid.Column="1"
                        Content="Send"
                        Margin="8,0,0,0"
                        Padding="16,6"
                        VerticalAlignment="Center"
                        FontSize="13"/>
            </Grid>
        </Border>

        <!-- ── Body: chat area + user list ── -->
        <Grid ColumnDefinitions="*,Auto">

            <!-- Chat output -->
            <views:IrcOutputBox x:Name="outputBox" Grid.Column="0"/>

            <!-- ── User list ──
                 A filter box over a grouped roster. Headers and user rows share one ListBox
                 (see UserGroupHeaderViewModel) so selection and the right-click menu work
                 across the whole list; the headers opt out of hit-testing via IsSelectable. -->
            <Border Grid.Column="1" Width="248"
                    Background="{DynamicResource SurfaceContent}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>

                    <!-- Filter -->
                    <Border DockPanel.Dock="Top"
                            Margin="12,12,12,8" Height="30"
                            Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <ic:SymbolIcon Grid.Column="0" Symbol="Search" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            <TextBox x:Name="userFilterBox" Grid.Column="1"
                                     Margin="8,0,0,0" Padding="0" MinHeight="0"
                                     Text="{Binding UserFilter, Mode=TwoWay}"
                                     PlaceholderText="{Binding UserFilterWatermark}"
                                     Background="Transparent" BorderThickness="0"
                                     FontSize="12.5"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}"/>
                        </Grid>
                    </Border>

                    <!-- Roster -->
                    <ListBox x:Name="userBox"
                             ItemsSource="{Binding UserRows}"
                             SelectedItem="{Binding SelectedUser}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="8,0,8,12">
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="userContextMenu">
                                <MenuItem Header="Whois"           Command="{Binding UserCommand}" CommandParameter="/whois"/>
                                <MenuItem Header="Private message" Command="{Binding UserCommand}" CommandParameter="/query"/>
                                <Separator/>
                                <MenuItem Header="Op"              Command="{Binding UserCommand}" CommandParameter="/mode +o"/>
                                <MenuItem Header="Deop"            Command="{Binding UserCommand}" CommandParameter="/mode -o"/>
                                <MenuItem Header="Voice"           Command="{Binding UserCommand}" CommandParameter="/mode +v"/>
                                <MenuItem Header="Devoice"         Command="{Binding UserCommand}" CommandParameter="/mode -v"/>
                                <Separator/>
                                <MenuItem Header="Kick"            Command="{Binding UserCommand}" CommandParameter="/kick"/>
                                <MenuItem Header="Ban"             Command="{Binding UserCommand}" CommandParameter="/ban"/>
                                <MenuItem Header="Kick + Ban"      Command="{Binding UserCommand}" CommandParameter="/ban -k"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="CornerRadius" Value="4"/>
                                <!-- Group headers report IsSelectable=false, which keeps the
                                     pointer (and so hover and selection) off them entirely. -->
                                <Setter Property="IsHitTestVisible" Value="{Binding IsSelectable}"/>
                                <Setter Property="Focusable" Value="{Binding IsSelectable}"/>
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="{TemplateBinding CornerRadius}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter Content="{TemplateBinding Content}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                                <Style Selector="^:pointerover /template/ Border">
                                    <Setter Property="Background" Value="{DynamicResource SubtleHoverBackground}"/>
                                </Style>
                                <Style Selector="^:selected /template/ Border">
                                    <Setter Property="Background" Value="{DynamicResource SubtleSelectedBackground}"/>
                                </Style>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:UserGroupHeaderViewModel">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontSize="11" FontWeight="SemiBold" LetterSpacing="0.4"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Count}"
                                               Margin="6,0,0,0"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextQuaternary}"/>
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="vm:UserViewModel">
                                <Grid ColumnDefinitions="12,*,Auto" Height="32">
                                    <TextBlock Grid.Column="0" Text="{Binding PrefixGlyph}"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding Mode, Converter={StaticResource ModeToBrushConverter}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Nick}"
                                               Margin="9,0,0,0"
                                               FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Nick, Converter={StaticResource NickColorConverter}}"/>
                                    <Border Grid.Column="2" Margin="9,0,0,0"
                                            IsVisible="{Binding HasTag}"
                                            VerticalAlignment="Center"
                                            Padding="5,1" CornerRadius="3"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding Tag}" FontSize="10"
                                                   Foreground="{DynamicResource TextQuaternary}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>

</UserControl>
