<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="clr-namespace:MutinyIRC.UI.ViewModels"
        xmlns:proto="clr-namespace:MutinyIRC.UI.ViewModels.Prototype"
        xmlns:design="clr-namespace:MutinyIRC.UI.ViewModels.Design"
        x:Class="MutinyIRC.UI.Views.ServerSettingsWindow"
        Title="Networks"
        Width="800" Height="640"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceContent}">

    <Design.DataContext>
        <design:DesignSettingsViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <ControlTheme x:Key="SettingsListBoxItemTheme" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border">
                <Setter Property="Background" Value="{DynamicResource SubtleHoverBackground}"/>
            </Style>
            <Style Selector="^:selected /template/ Border">
                <Setter Property="Background" Value="{DynamicResource SubtleSelectedBackground}"/>
            </Style>
        </ControlTheme>
    </Window.Resources>

    <Window.Styles>
        <!-- The rail's + / - strip: two flat cells that fill the width, not framed buttons. -->
        <Style Selector="Button.railAction">
            <Setter Property="Height" Value="34"/>
            <!-- Fill the half of the strip the button sits in, so its glyph centres over that
                 half rather than hugging the left edge of a button sized to its content. -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceLayerAlt}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.railAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBackground}"/>
        </Style>

        <!-- The reorder arrows and the row's remove cross. All three stay quiet until you are
             on the row, which is what keeps a table of hosts readable. -->
        <Style Selector="Button.rowAction">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBackground}"/>
        </Style>
        <Style Selector="Border.serverRow Button.rowReveal">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.serverRow:pointerover Button.rowReveal">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- A text action, such as Forget on a pin line: no frame, only the accent colour. -->
        <Style Selector="Button.link">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>

        <!-- The first entry point is the one dialled first, so its number carries the accent. -->
        <Style Selector="TextBlock.order">
            <Setter Property="Foreground" Value="{DynamicResource TextQuaternary}"/>
        </Style>
        <Style Selector="TextBlock.order.first">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- The line under a switch that says what it does now. A setting that lowers your
             protection says so in the warning colour. -->
        <Style Selector="TextBlock.switchHint">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        </Style>
        <Style Selector="TextBlock.switchHint.warning">
            <Setter Property="Foreground" Value="{DynamicResource StatusWarningForeground}"/>
        </Style>

        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <!-- An input that sits inside a row or a chip, rather than framing itself. The stock
             focus look draws its own fill and outline, which breaks the shape it sits in; the
             caret is what says where you are typing. -->
        <Style Selector="TextBox.inline">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TextBox.inline /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
    </Window.Styles>

    <Panel>
    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="24,22,24,14">
            <StackPanel Spacing="2">
                <TextBlock Text="Networks" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Servers Mutiny connects to, and the identity it uses on each."
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <!-- Footer: Save / Cancel -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceLayerAlt}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Save" Width="88" Classes="accent" IsDefault="True" Click="OkButton_Click"/>
                <Button Content="Cancel" Width="88" IsCancel="True" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="228,*" ColumnSpacing="20" Margin="24,0,24,16">

            <!-- The network rail -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceLayerAlt}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*"
                          Background="{DynamicResource DividerBrush}">
                        <Button Grid.Column="0" Classes="railAction"
                                Margin="0,1,0,0"
                                ToolTip.Tip="Add a network"
                                Command="{Binding AddNetworkCommand}">
                            <ic:SymbolIcon Symbol="Add" FontSize="14"/>
                        </Button>
                        <Button Grid.Column="1" Classes="railAction"
                                Margin="1,1,0,0"
                                ToolTip.Tip="Remove the selected network"
                                Command="{Binding RemoveNetworkCommand}">
                            <ic:SymbolIcon Symbol="Subtract" FontSize="14"/>
                        </Button>
                    </Grid>

                    <ListBox x:Name="networksListBox"
                             ItemsSource="{Binding Networks}"
                             SelectedItem="{Binding SelectedNetwork}"
                             ItemContainerTheme="{StaticResource SettingsListBoxItemTheme}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4"
                             ToolTip.Tip="Double-click a network to rename it"
                             DoubleTapped="NetworksListBox_DoubleTapped">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NetworkSettingsViewModel}">
                                <Grid>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !IsEditing}"/>
                                    <TextBox Text="{Binding EditName}"
                                             FontSize="13"
                                             BorderThickness="0" Background="Transparent" Padding="1,0"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             IsVisible="{Binding IsEditing}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding CommitEditCommand}"/>
                                            <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}"/>
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- The selected network -->
            <ScrollViewer Grid.Column="1"
                          IsVisible="{Binding !IsSheetOpen, Source={x:Static proto:EntryPointEditPrototype.Instance}}"
                          HorizontalScrollBarVisibility="Disabled"
                          IsEnabled="{Binding SelectedNetwork, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8" Margin="0,0,10,0" DataContext="{Binding SelectedNetwork}">

                    <!-- Entry points, in failover order -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="sectionLabel" Text="Servers"/>
                            <TextBlock Text="Tried top to bottom until one answers"
                                       FontSize="11"
                                       VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource TextQuaternary}"/>
                        </StackPanel>

                        <Border Classes="card" ClipToBounds="True">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Servers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ServerSettingsViewModel}">
                                            <Border Classes="serverRow"
                                                    DoubleTapped="ServerRow_DoubleTapped"
                                                    Padding="4,0,6,0"
                                                    BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Background="Transparent">
                                              <StackPanel>
                                                <Grid ColumnDefinitions="16,20,*,Auto,Auto,Auto,22"
                                                      IsVisible="{Binding !IsInlineEditing}"
                                                      Height="35"
                                                      VerticalAlignment="Center">

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <Button Classes="rowAction rowReveal"
                                                                Width="16" Height="15"
                                                                ToolTip.Tip="Try this server earlier"
                                                                Command="{Binding $parent[ItemsControl].DataContext.MoveServerUpCommand}"
                                                                CommandParameter="{Binding}">
                                                            <ic:SymbolIcon Symbol="ChevronUp" FontSize="9"/>
                                                        </Button>
                                                        <Button Classes="rowAction rowReveal"
                                                                Width="16" Height="15"
                                                                ToolTip.Tip="Try this server later"
                                                                Command="{Binding $parent[ItemsControl].DataContext.MoveServerDownCommand}"
                                                                CommandParameter="{Binding}">
                                                            <ic:SymbolIcon Symbol="ChevronDown" FontSize="9"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Classes="order"
                                                               Classes.first="{Binding IsFirst}"
                                                               Text="{Binding Order}"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Url}"
                                                               FontSize="13"
                                                               Margin="6,0,10,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Port}"
                                                               FontSize="12.5"
                                                               Margin="0,0,10,0"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center"/>

                                                    <Border Grid.Column="4"
                                                            CornerRadius="3"
                                                            Padding="6,1"
                                                            Margin="0,0,4,0"
                                                            VerticalAlignment="Center"
                                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                                            BorderThickness="1">
                                                        <Panel>
                                                            <TextBlock Text="TLS" FontSize="10.5"
                                                                       IsVisible="{Binding Ssl}"
                                                                       Foreground="{DynamicResource StatusSuccessForeground}"/>
                                                            <TextBlock Text="plain" FontSize="10.5"
                                                                       IsVisible="{Binding !Ssl}"
                                                                       Foreground="{DynamicResource TextQuaternary}"/>
                                                        </Panel>
                                                    </Border>

                                                    <!-- PROTOTYPE: one edit/move affordance per variant. -->
                                                    <Panel Grid.Column="5">
                                                        <Button Classes="rowAction rowReveal"
                                                                Width="22" Height="22"
                                                                ToolTip.Tip="Edit or move this server"
                                                                IsVisible="{Binding IsA, Source={x:Static proto:EntryPointEditPrototype.Instance}}"
                                                                Click="MoreButton_Click">
                                                            <ic:SymbolIcon Symbol="MoreHorizontal" FontSize="12"/>
                                                        </Button>
                                                        <Button Classes="rowAction rowReveal"
                                                                Width="22" Height="22"
                                                                ToolTip.Tip="Edit this server"
                                                                IsVisible="{Binding IsB, Source={x:Static proto:EntryPointEditPrototype.Instance}}">
                                                            <ic:SymbolIcon Symbol="Edit" FontSize="11"/>
                                                            <Button.Flyout>
                                                                <Flyout Placement="BottomEdgeAlignedRight"
                                                                        Opening="EditFlyout_Opening"
                                                                        Closed="EditFlyout_Closed">
                                                                    <StackPanel Width="300" Spacing="8" Margin="4" KeyDown="Editor_KeyDown">
                                                                        <TextBlock Text="Edit server" FontWeight="SemiBold" FontSize="13"/>
                                                                        <StackPanel Spacing="3">
                                                                            <TextBlock Classes="fieldLabel" Text="Host" Margin="0"/>
                                                                            <TextBox Text="{Binding DraftHost}" FontSize="12.5"/>
                                                                        </StackPanel>
                                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                                                            <StackPanel Spacing="3">
                                                                                <TextBlock Classes="fieldLabel" Text="Port" Margin="0"/>
                                                                                <TextBox Text="{Binding DraftPort}"
                                                                                         PlaceholderText="{Binding DraftPortPlaceholder}"
                                                                                         FontSize="12.5"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1" Spacing="3">
                                                                                <TextBlock Classes="fieldLabel" Text="TLS" Margin="0"/>
                                                                                <ToggleSwitch IsChecked="{Binding DraftSsl}"
                                                                                              OnContent="On" OffContent="Off"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                        <StackPanel Spacing="3">
                                                                            <TextBlock Classes="fieldLabel" Text="Network" Margin="0"/>
                                                                            <ComboBox ItemsSource="{Binding AllNetworks}"
                                                                                      SelectedItem="{Binding DraftNetwork}"
                                                                                      HorizontalAlignment="Stretch" FontSize="12.5">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate DataType="{x:Type vm:NetworkSettingsViewModel}">
                                                                                        <TextBlock Text="{Binding Name}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                            <TextBlock Classes="switchHint" IsVisible="{Binding IsMoving}"
                                                                                       TextWrapping="Wrap"
                                                                                       Text="Moves this server to the end of that network's list. The pin goes with it."/>
                                                                        </StackPanel>
                                                                        <TextBlock Classes="switchHint" IsVisible="{Binding IsPinned}"
                                                                                   Text="{Binding PinLine}"/>
                                                                        <TextBlock Classes="switchHint warning" IsVisible="{Binding PinWillClear}"
                                                                                   TextWrapping="Wrap"
                                                                                   Text="Applying this change forgets the pinned certificate."/>
                                                                        <Border IsVisible="{Binding HasRefusal}"
                                                                                Background="{DynamicResource StatusErrorBackground}"
                                                                                CornerRadius="3" Padding="8,5">
                                                                            <TextBlock Text="{Binding Refusal}" FontSize="11.5" TextWrapping="Wrap"
                                                                                       Foreground="{DynamicResource StatusErrorForeground}"/>
                                                                        </Border>
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                                                            <Button Content="Cancel" FontSize="12" Click="FlyoutCancel_Click"/>
                                                                            <Button Content="Apply" Classes="accent" FontSize="12" Click="FlyoutApply_Click"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <Button Classes="rowAction rowReveal"
                                                                Width="22" Height="22"
                                                                ToolTip.Tip="Open this server"
                                                                IsVisible="{Binding IsC, Source={x:Static proto:EntryPointEditPrototype.Instance}}"
                                                                Click="OpenSheet_Click">
                                                            <ic:SymbolIcon Symbol="ChevronRight" FontSize="11"/>
                                                        </Button>
                                                    </Panel>

                                                    <Button Grid.Column="6"
                                                            Classes="rowAction rowReveal"
                                                            Width="22" Height="22"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="Remove this server"
                                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveServerCommand}"
                                                            CommandParameter="{Binding}">
                                                        <ic:SymbolIcon Symbol="Dismiss" FontSize="10"/>
                                                    </Button>
                                                </Grid>

                                                <!-- PROTOTYPE A: the row itself becomes the editor. -->
                                                <StackPanel IsVisible="{Binding IsInlineEditing}"
                                                            Margin="36,6,0,7" Spacing="5"
                                                            KeyDown="Editor_KeyDown">
                                                    <Grid ColumnDefinitions="*,72,Auto,Auto,Auto" ColumnSpacing="6">
                                                        <TextBox Text="{Binding DraftHost}" FontSize="12.5"
                                                                 PlaceholderText="host"/>
                                                        <TextBox Grid.Column="1" Text="{Binding DraftPort}"
                                                                 PlaceholderText="{Binding DraftPortPlaceholder}" FontSize="12.5"/>
                                                        <CheckBox Grid.Column="2" Content="TLS" IsChecked="{Binding DraftSsl}"
                                                                  FontSize="12" Margin="4,0,0,0"/>
                                                        <Button Grid.Column="3" Content="Apply" Classes="accent"
                                                                FontSize="12" Padding="10,3" VerticalAlignment="Center"
                                                                Click="InlineApply_Click"/>
                                                        <Button Grid.Column="4" Content="Cancel"
                                                                FontSize="12" Padding="10,3" VerticalAlignment="Center"
                                                                Click="InlineCancel_Click"/>
                                                    </Grid>
                                                    <TextBlock Classes="switchHint warning" IsVisible="{Binding PinWillClear}"
                                                               Text="Applying this change forgets the pinned certificate."/>
                                                    <TextBlock IsVisible="{Binding HasRefusal}" Text="{Binding Refusal}"
                                                               FontSize="11.5" Foreground="{DynamicResource StatusErrorForeground}"/>
                                                </StackPanel>

                                                <!-- The pin of this entry point, if it has one. Forget clears it
                                                     when the dialog is saved, as the other edits here are. -->
                                                <StackPanel x:Name="pinLine"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            Margin="42,-6,0,7"
                                                            IsVisible="{Binding IsPinned}">
                                                    <TextBlock Text="{Binding PinLine}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center"/>
                                                    <Button x:Name="forgetPinButton"
                                                            Classes="link"
                                                            Content="Forget"
                                                            ToolTip.Tip="Forget the pinned certificate of this server"
                                                            Command="{Binding ForgetPinCommand}"/>
                                                </StackPanel>
                                              </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="36"
                                        Padding="10,0,8,0"
                                        Background="{DynamicResource SurfaceLayerAlt}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0"
                                                 x:Name="newServerBox"
                                                 Classes="inline"
                                                 Text="{Binding NewServerText}"
                                                 PlaceholderText="add server — host:port"
                                                 FontSize="12.5"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding AddServerCommand}"/>
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <Button Grid.Column="1"
                                                x:Name="addServerButton"
                                                Content="Add"
                                                Classes="accent"
                                                FontSize="12"
                                                Padding="10,3"
                                                VerticalAlignment="Center"
                                                Command="{Binding AddServerCommand}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Connection settings. The verify switch is live. The others are drawn
                         and disabled: the settings behind them are not wired up yet, and the
                         tooltip on each card says so. -->
                    <Border Classes="card" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Verify TLS certificates" FontSize="13"/>
                                <TextBlock x:Name="verifyTlsHint"
                                           Classes="switchHint"
                                           Classes.warning="{Binding IsVerifyCertificatesHintWarning}"
                                           Text="{Binding VerifyCertificatesHint}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="verifyTlsToggle"
                                          IsChecked="{Binding VerifyCertificates}"
                                          IsEnabled="{Binding CanVerifyCertificates}"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="14,10"
                            ToolTip.Tip="Not wired up yet — FlamingIRC has no capability negotiation.">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SASL authentication" FontSize="13"/>
                                <TextBlock Text="Sends your password when connecting, to log you in"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="saslToggle"
                                          IsChecked="False" IsEnabled="False"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Classes="card" Padding="14,10"
                            ToolTip.Tip="Not wired up yet — connecting to a network still turns this on by itself.">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Connect on startup" FontSize="13"/>
                                <TextBlock Text="Dials this network when Mutiny opens"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="autoConnectToggle"
                                          IsChecked="{Binding AutoConnect}" IsEnabled="False"
                                          OnContent="" OffContent=""
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Identity on this network -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,2,0,0">
                        <StackPanel Grid.Column="0">
                            <TextBlock Classes="fieldLabel" Text="Nickname"/>
                            <TextBox Text="{Binding Nick}" FontSize="13" Height="32"
                                     PlaceholderText="{Binding NickWatermark}"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="fieldLabel" Text="Alternate"/>
                            <TextBox Text="{Binding AlternateNick}" FontSize="13" Height="32"
                                     PlaceholderText="{Binding AlternateNickWatermark}"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Autojoin. Being on this list is what makes a channel autojoin. -->
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <TextBlock Classes="sectionLabel" Text="Autojoin on connect"/>
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Channels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ChannelSettingsViewModel}">
                                        <Border Height="26"
                                                Margin="0,0,6,6"
                                                Padding="10,0,4,0"
                                                CornerRadius="13"
                                                Background="{DynamicResource ButtonBackground}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="5"
                                                        VerticalAlignment="Center">
                                                <ic:SymbolIcon Symbol="LockClosed" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               ToolTip.Tip="Joined with a key"
                                                               IsVisible="{Binding IsKeyed}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                           VerticalAlignment="Center"/>
                                                <Button Classes="rowAction"
                                                        Width="18" Height="18"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Stop joining this channel"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveChannelCommand}"
                                                        CommandParameter="{Binding}">
                                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="9"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Panel Height="26" Margin="0,0,0,6"
                                   IsVisible="{Binding !IsAddingChannel}">
                                <Rectangle RadiusX="13" RadiusY="13"
                                           StrokeThickness="1"
                                           StrokeDashArray="3,2"
                                           Stroke="{DynamicResource ControlBorderBrush}"/>
                                <Button x:Name="addChannelButton"
                                        Content="+ Add channel"
                                        FontSize="12.5"
                                        Padding="10,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="13"
                                        Foreground="{DynamicResource TextTertiary}"
                                        VerticalContentAlignment="Center"
                                        Command="{Binding BeginAddChannelCommand}"
                                        Click="AddChannelButton_Click"/>
                            </Panel>

                            <Border Height="26" Margin="0,0,0,6"
                                    Padding="10,0"
                                    CornerRadius="13"
                                    Background="{DynamicResource ButtonBackground}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    IsVisible="{Binding IsAddingChannel}">
                                <TextBox x:Name="newChannelBox"
                                         Classes="inline"
                                         Text="{Binding NewChannelText}"
                                         PlaceholderText="#channel key"
                                         FontSize="12.5"
                                         Width="150"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding AddChannelCommand}"/>
                                        <KeyBinding Gesture="Escape" Command="{Binding CancelAddChannelCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- PROTOTYPE C: the edit sheet takes over the right column. -->
            <DockPanel Grid.Column="1"
                       IsVisible="{Binding IsSheetOpen, Source={x:Static proto:EntryPointEditPrototype.Instance}}"
                       DataContext="{Binding SheetRow, Source={x:Static proto:EntryPointEditPrototype.Instance}}"
                       KeyDown="Editor_KeyDown">
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
                    <Button Classes="link" FontSize="12" Content="‹ All servers" Click="SheetCancel_Click"/>
                    <TextBlock Text="{Binding Url}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Order, StringFormat='Number {0} in the failover order'}"
                               FontSize="11.5" Foreground="{DynamicResource TextTertiary}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                            Spacing="6" Margin="0,10,0,0">
                    <Button Content="Cancel" FontSize="12" Click="SheetCancel_Click"/>
                    <Button Content="Done" Classes="accent" FontSize="12" Click="SheetApply_Click"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10" Margin="0,0,10,0">
                        <Border IsVisible="{Binding HasRefusal}"
                                Background="{DynamicResource StatusErrorBackground}"
                                CornerRadius="4" Padding="10,7">
                            <TextBlock Text="{Binding Refusal}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource StatusErrorForeground}"/>
                        </Border>

                        <TextBlock Classes="sectionLabel" Text="Address"/>
                        <Border Classes="card" Padding="14,10">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="fieldLabel" Text="Host" Margin="0"/>
                                    <TextBox Text="{Binding DraftHost}" FontSize="12.5"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="fieldLabel" Text="Port" Margin="0"/>
                                        <TextBox Text="{Binding DraftPort}"
                                                 PlaceholderText="{Binding DraftPortPlaceholder}" FontSize="12.5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Classes="fieldLabel" Text="TLS" Margin="0"/>
                                        <ToggleSwitch IsChecked="{Binding DraftSsl}" OnContent="On" OffContent="Off"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="switchHint" TextWrapping="Wrap"
                                           Text="Leave the port blank to use 6697 with TLS or 6667 without."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="sectionLabel" Text="Certificate"/>
                        <Border Classes="card" Padding="14,10">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPinned}">
                                    <TextBlock Text="{Binding PinLine}" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Classes="link" Content="Forget" Command="{Binding ForgetPinCommand}"/>
                                </StackPanel>
                                <TextBlock Text="No pinned certificate." FontSize="12"
                                           Foreground="{DynamicResource TextTertiary}"
                                           IsVisible="{Binding !IsPinned}"/>
                                <TextBlock Classes="switchHint warning" IsVisible="{Binding PinWillClear}" TextWrapping="Wrap"
                                           Text="A new host or port, or TLS off, forgets the pinned certificate when you press Done."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="sectionLabel" Text="Network"/>
                        <Border Classes="card" Padding="14,10">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <TextBlock Text="Belongs to" FontSize="13" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AllNetworks}"
                                              SelectedItem="{Binding DraftNetwork}"
                                              HorizontalAlignment="Stretch" FontSize="12.5">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NetworkSettingsViewModel}">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Classes="switchHint" IsVisible="{Binding IsMoving}" TextWrapping="Wrap"
                                           Text="Done moves this server to the end of that network's failover order. The pin goes with it."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>

    <!-- PROTOTYPE: the variant switcher. Not part of any design. ← and → also switch. -->
    <Border IsVisible="{x:Static proto:EntryPointEditPrototype.IsEnabled}"
            DataContext="{x:Static proto:EntryPointEditPrototype.Instance}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,74" Padding="6,4"
            CornerRadius="16" Background="#E6202020"
            BoxShadow="0 2 10 0 #60000000">
        <StackPanel Spacing="1">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Button Content="◀" Command="{Binding PreviousCommand}" Foreground="White"
                        Background="Transparent" Padding="8,2" Focusable="False"/>
                <TextBlock Text="{Binding VariantLabel}" Foreground="White" FontWeight="SemiBold"
                           FontSize="12.5" VerticalAlignment="Center" MinWidth="130" TextAlignment="Center"/>
                <Button Content="▶" Command="{Binding NextCommand}" Foreground="White"
                        Background="Transparent" Padding="8,2" Focusable="False"/>
            </StackPanel>
            <TextBlock Text="{Binding LastAction}" Foreground="#C0FFFFFF" FontSize="10.5"
                       HorizontalAlignment="Center" Margin="10,0,10,3" MaxWidth="560"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
    </Panel>
</Window>
