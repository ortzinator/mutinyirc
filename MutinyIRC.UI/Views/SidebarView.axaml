<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MutinyIRC.UI.ViewModels"
             xmlns:views="clr-namespace:MutinyIRC.UI.Views"
             xmlns:design="clr-namespace:MutinyIRC.UI.ViewModels.Design"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             mc:Ignorable="d"
             x:Class="MutinyIRC.UI.Views.SidebarView">

    <Design.DataContext>
        <design:DesignMainViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/SidebarNavTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource SurfaceNav}">

        <!-- App header row. ElementRole=TitleBar hands this strip to the platform's
             non-client hit-testing, so it drags, double-click-maximizes and snaps
             like a real title bar. Child controls default to a role of None and
             keep receiving normal input. -->
        <Border DockPanel.Dock="Top" Height="48"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                Background="{DynamicResource SurfaceNav}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <!-- No app-name label here: the theme draws Window.Title into this
                 strip once the client area is extended, so a label of our own
                 would sit on top of it. -->
            <Grid Margin="14,0,8,0">
                <Button Theme="{StaticResource SidebarNavTheme}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="6" CornerRadius="20"
                        ToolTip.Tip="Settings">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Settings..." Click="AppSettingsMenuItem_Click"/>
                            <MenuItem Header="Servers..." Click="ManageNetworks_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <ic:SymbolIcon Symbol="Settings" FontSize="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Network switcher ═══
             The sidebar lists one connection at a time. This button names that connection
             and says where it stands; every other connection lives in its flyout. -->
        <Border DockPanel.Dock="Top" Padding="10,10,12,8">
            <Button x:Name="NetworkSwitcherButton"
                    Height="40" CornerRadius="5"
                    Padding="10,0,8,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center">
                <Button.Styles>
                    <!-- The open flyout is what the accent outline marks, as in the design. -->
                    <Style Selector="Button:flyout-open">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillBrush}"/>
                    </Style>
                </Button.Styles>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ShownServer.NetworkName, FallbackValue='Not connected'}"
                                   FontSize="13" FontWeight="SemiBold" LineHeight="15"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ShownServer.ConnectionStatus}"
                                   FontSize="10" LineHeight="12"
                                   Foreground="{DynamicResource TextTertiary}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding ShownServer, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                    <!-- Unread on a connection the sidebar is not showing. A dot, not a
                         count: nothing in the client counts unread messages. -->
                    <Ellipse Grid.Column="1" Width="8" Height="8"
                             Margin="8,0,0,0" VerticalAlignment="Center"
                             Fill="{DynamicResource AccentFillBrush}"
                             IsVisible="{Binding HasUnreadElsewhere}"
                             ToolTip.Tip="Unread on another network"/>
                    <ic:SymbolIcon Grid.Column="2" Symbol="ChevronDown" FontSize="12"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiary}"/>
                </Grid>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel MinWidth="188">
                            <ItemsControl ItemsSource="{Binding Servers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServerViewModel}">
                                        <!-- The row shows the connection and closes the flyout in one
                                             handler. A bound Command cannot do it: Hide() detaches the
                                             flyout content, which clears the row's DataContext before
                                             the Command runs. -->
                                        <Button Theme="{StaticResource SidebarNavTheme}"
                                                Classes.active="{Binding IsShown}"
                                                Padding="8,6" Margin="0,1,0,0"
                                                Click="NetworkRow_Click">
                                            <Grid ColumnDefinitions="18,*,Auto,Auto">
                                                <ic:SymbolIcon Grid.Column="0" Symbol="Checkmark" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsShown}"
                                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding NetworkName}"
                                                           FontSize="13" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Ellipse Grid.Column="2" Width="8" Height="8"
                                                         Margin="8,0,0,0" VerticalAlignment="Center"
                                                         Fill="{DynamicResource AccentFillBrush}"
                                                         IsVisible="{Binding HasUnreadAnywhere}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ConnectionStatus}"
                                                           FontSize="10" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextQuaternary}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Margin="8,4"
                                    Background="{DynamicResource DividerBrush}"/>
                            <Button Theme="{StaticResource SidebarNavTheme}"
                                    Padding="8,6"
                                    Click="ManageNetworks_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Add" FontSize="13" Width="18"
                                                   VerticalAlignment="Center"/>
                                    <TextBlock Text="Manage networks…" FontSize="13"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Border>

        <!-- ═══ Panel list ═══
             Only the shown connection's panels. Its console is pinned above the groups:
             the design has no row for it, but it is a real panel and this is the only way
             back to the MOTD, the connect lines and whois output.
             No shown connection means no list at all, so nothing below has to ask again. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding ShownServer, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Margin="8,0,8,8" DataContext="{Binding ShownServer}">
                <StackPanel.Styles>
                    <!-- Group heading. -->
                    <Style Selector="TextBlock.groupHeading">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="LetterSpacing" Value="0.4"/>
                        <Setter Property="Margin" Value="8,10,8,4"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                    </Style>
                    <!-- The prefix is a channel row's icon, so it takes the accent on the
                         selected row like one. -->
                    <Style Selector="Button.active TextBlock#prefixGlyph">
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                    </Style>
                </StackPanel.Styles>

                <!-- Console -->
                <Button Theme="{StaticResource SidebarNavTheme}"
                        Classes.active="{Binding IsSelected}"
                        Classes.unread="{Binding HasUnread}"
                        Command="{Binding $parent[views:SidebarView].DataContext.SelectPanelCommand}"
                        CommandParameter="{Binding}"
                        Padding="12,5,8,5" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="16,*,Auto">
                        <ic:SymbolIcon Grid.Column="0" Symbol="Server" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Host}"
                                   FontSize="13" Margin="9,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="(away)" FontSize="11"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   IsVisible="{Binding IsAway}"
                                   Foreground="{DynamicResource TextTertiary}"/>
                    </Grid>
                </Button>

                <!-- Channels -->
                <TextBlock Classes="groupHeading" Text="CHANNELS"
                           IsVisible="{Binding Channels.Count}"/>
                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChannelViewModel}">
                            <Button Theme="{StaticResource SidebarNavTheme}"
                                    Classes="closable"
                                    Classes.active="{Binding IsSelected}"
                                    Classes.unread="{Binding HasUnread}"
                                    Command="{Binding $parent[views:SidebarView].DataContext.SelectPanelCommand}"
                                    CommandParameter="{Binding}"
                                    Margin="0,1,0,0">
                                <Grid ColumnDefinitions="16,*,Auto">
                                    <TextBlock x:Name="prefixGlyph" Grid.Column="0"
                                               Text="{Binding Prefix}"
                                               FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ChannelName}"
                                               FontSize="13" Margin="9,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <ic:SymbolIcon Grid.Column="2" Symbol="LockClosed" FontSize="12"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsKeyed}"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   ToolTip.Tip="Needs a key to enter"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Direct messages -->
                <TextBlock Classes="groupHeading" Text="DIRECT MESSAGES"
                           IsVisible="{Binding PrivateMessages.Count}"/>
                <ItemsControl ItemsSource="{Binding PrivateMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PrivateMessageViewModel}">
                            <Button Theme="{StaticResource SidebarNavTheme}"
                                    Classes="closable"
                                    Classes.active="{Binding IsSelected}"
                                    Classes.unread="{Binding HasUnread}"
                                    Command="{Binding $parent[views:SidebarView].DataContext.SelectPanelCommand}"
                                    CommandParameter="{Binding}"
                                    Margin="0,1,0,0">
                                <Grid ColumnDefinitions="16,*">
                                    <ic:SymbolIcon Grid.Column="0" Symbol="Person" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OtherNick}"
                                               FontSize="13" Margin="9,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</UserControl>
