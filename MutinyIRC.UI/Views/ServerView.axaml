<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MutinyIRC.UI.Controls"
             xmlns:views="clr-namespace:MutinyIRC.UI.Views"
             xmlns:vm="clr-namespace:MutinyIRC.UI.ViewModels"
             mc:Ignorable="d"
             x:Class="MutinyIRC.UI.Views.ServerView"
             Background="{DynamicResource AppBackground}">

    <Design.DataContext>
        <vm:ServerViewModel />
    </Design.DataContext>

    <DockPanel>

        <!-- ── Server header ── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ChannelHeaderBackground}"
                BorderBrush="{DynamicResource ChannelHeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0" Height="48">
            <TextBlock Text="{Binding Name}"
                       FontWeight="SemiBold" FontSize="15"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- ── Message input ── -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ChatInputAreaBackground}"
                BorderBrush="{DynamicResource ChannelHeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <Border Grid.Column="0"
                        Background="{DynamicResource AppBackground}"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource ChatBorderBrush}"
                        BorderThickness="1"
                        Padding="4,0">
                    <local:CommandTextBox x:Name="commandBox"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          PlaceholderText="Enter a command..."
                                          FontSize="14"
                                          VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="sendButton"
                        Grid.Column="1"
                        Content="Send"
                        Margin="8,0,0,0"
                        Padding="16,6"
                        VerticalAlignment="Center"
                        FontSize="13"/>
            </Grid>
        </Border>

        <!-- ── Server console output ── -->
        <views:IrcOutputBox x:Name="outputBox"/>

    </DockPanel>

</UserControl>
