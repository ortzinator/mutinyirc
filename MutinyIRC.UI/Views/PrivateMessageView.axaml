<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MutinyIRC.UI.Controls"
             xmlns:views="clr-namespace:MutinyIRC.UI.Views"
             xmlns:design="clr-namespace:MutinyIRC.UI.ViewModels.Design"
             mc:Ignorable="d"
             x:Class="MutinyIRC.UI.Views.PrivateMessageView"
             x:Name="pmPanel"
             Background="{DynamicResource SurfaceContent}">

    <Design.DataContext>
        <design:DesignPrivateMessageViewModel />
    </Design.DataContext>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceLayer}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="{DynamicResource PanelHeaderPadding}" Height="48">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right"
                           Text="(disconnected)"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiary}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           IsVisible="{Binding !IsServerConnected}"/>
                <TextBlock Text="{Binding OtherNick}"
                           FontWeight="SemiBold" FontSize="15"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Message input bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceLayerAlt}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto">
                <Border Grid.Column="0"
                        Background="{DynamicResource InputBackground}"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        Padding="4,0">
                    <local:CommandTextBox x:Name="commandBox"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          PlaceholderText="Message..."
                                          FontSize="14"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding IsServerConnected}"/>
                </Border>
                <Button x:Name="sendButton"
                        Grid.Column="1"
                        Content="Send"
                        Margin="8,0,0,0"
                        Padding="16,6"
                        VerticalAlignment="Center"
                        FontSize="13"
                        IsEnabled="{Binding IsServerConnected}"/>
            </Grid>
        </Border>

        <!-- Chat output -->
        <views:IrcOutputBox x:Name="outputBox"/>
    </DockPanel>

</UserControl>
