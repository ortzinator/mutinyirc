<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="MutinyIRC.UI.Views.IrcOutputBox"
             x:Name="root">

    <DockPanel>
        <!-- Jump-to-bottom strip. It only has one surface step to work with in light mode,
             where content and layer are both white, so the accent text is what makes it
             read as something you can click. -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding ElementName=root, Path=Scrolled}"
                Background="{DynamicResource SurfaceLayerAlt}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Cursor="Hand"
                PointerPressed="ScrollIndicator_PointerPressed">
            <TextBlock HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentTextBrush}"
                       FontSize="8">▼ ▼</TextBlock>
        </Border>
        <ScrollViewer x:Name="scrollViewer" Background="{DynamicResource SurfaceContent}">
            <ItemsControl x:Name="outputItems" ItemsSource="{Binding ChatLines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</UserControl>
