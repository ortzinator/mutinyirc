<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MutinyIRC.UI.Controls.TopicBar"
             x:Name="Root"
             ClipToBounds="True"
             Focusable="True"
             IsVisible="{Binding Topic, ElementName=Root,
                         Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
    <Border Background="{DynamicResource SurfaceLayer}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,5,16,5">
        <Panel>
            <!-- Collapsed: single line, click to expand -->
            <TextBlock x:Name="topicCollapsed"
                       Text="{Binding Topic, ElementName=Root}"
                       FontSize="12"
                       Foreground="{DynamicResource TextTertiary}"
                       TextTrimming="CharacterEllipsis"
                       Cursor="Hand"
                       ToolTip.Tip="Click to expand"/>
            <!-- Expanded: full text, selectable -->
            <SelectableTextBlock x:Name="topicExpanded"
                                 Text="{Binding Topic, ElementName=Root}"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextTertiary}"
                                 TextWrapping="Wrap"
                                 IsVisible="False"/>
        </Panel>
    </Border>
</UserControl>
