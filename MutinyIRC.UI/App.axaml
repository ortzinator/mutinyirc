<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MutinyIRC.UI.ViewModels"
             xmlns:conv="clr-namespace:MutinyIRC.UI.Converters"
             x:Class="MutinyIRC.UI.App">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/DefaultTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:NickColorConverter x:Key="NickColorConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>

        <!-- Most-derived types must come before their base types.
             Avalonia searches top-to-bottom and uses IsInstanceOfType,
             so a base-class template listed first would match all subclasses. -->

        <DataTemplate DataType="{x:Type vm:ChannelActionViewModel}">
            <DockPanel Margin="16,2,16,2">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Time, StringFormat='HH:mm'}"
                           Foreground="{DynamicResource TextQuaternary}"
                           FontSize="11" Width="40" TextAlignment="Right"
                           VerticalAlignment="Top" Margin="0,2,10,0"
                           IsVisible="{Binding ShowTimestamps}"/>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2"
                           FontStyle="Italic">
                    <Run Text="* "
                         Foreground="{Binding User.Nick, Converter={StaticResource NickColorConverter}}"/>
                    <Run Text="{Binding User.Nick}"
                         Foreground="{Binding User.Nick, Converter={StaticResource NickColorConverter}}"
                         FontWeight="SemiBold"/>
                    <Run Text=" "/>
                    <Run Text="{Binding Message}"/>
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PrivateNoticeViewModel}">
            <Border Margin="12,3,12,3" Background="{DynamicResource StatusWarningBackground}"
                    CornerRadius="4" Padding="10,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Time, StringFormat='HH:mm'}"
                               Foreground="{DynamicResource TextQuaternary}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                               IsVisible="{Binding ShowTimestamps}"/>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding User.NamesLiteral}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusWarningForeground}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource StatusWarningForeground}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OutgoingNoticeViewModel}">
            <Border Margin="12,3,12,3" Background="{DynamicResource StatusWarningBackground}"
                    CornerRadius="4" Padding="10,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Time, StringFormat='HH:mm'}"
                               Foreground="{DynamicResource TextQuaternary}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                               IsVisible="{Binding ShowTimestamps}"/>
                    <TextBlock DockPanel.Dock="Left"
                               Foreground="{DynamicResource StatusWarningForeground}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0">
                        <Run Text="&#x2192;"/>
                        <Run Text="-"/><Run Text="{Binding User.Nick}"/><Run Text="-"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource StatusWarningForeground}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChannelMessageViewModel}">
            <DockPanel Margin="16,2,16,2">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Time, StringFormat='HH:mm'}"
                           Foreground="{DynamicResource TextQuaternary}"
                           FontSize="11" Width="40" TextAlignment="Right"
                           VerticalAlignment="Top" Margin="0,2,10,0"
                           IsVisible="{Binding ShowTimestamps}"/>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding User.NamesLiteral}"
                           FontWeight="SemiBold"
                           Foreground="{Binding User.Nick, Converter={StaticResource NickColorConverter}}"
                           VerticalAlignment="Top" Margin="0,2,8,0"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           VerticalAlignment="Top" Margin="0,2"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:IrcErrorViewModel}">
            <Border Margin="12,3,12,3" Background="{DynamicResource StatusErrorBackground}"
                    CornerRadius="4" Padding="10,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Time, StringFormat='HH:mm'}"
                               Foreground="{DynamicResource TextQuaternary}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                               IsVisible="{Binding ShowTimestamps}"/>
                    <TextBlock Foreground="{DynamicResource StatusErrorForeground}" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Error {0}: {1}">
                                <Binding Path="Code" />
                                <Binding Path="Message" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- A certificate refusal: an error block with the Trust button. It comes before the
             ErrorMessageViewModel template, which would match it too. -->
        <DataTemplate DataType="{x:Type vm:CertificateRefusalViewModel}">
            <Border Margin="12,3,12,3" Background="{DynamicResource StatusErrorBackground}"
                    CornerRadius="4" Padding="10,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Time, StringFormat='HH:mm'}"
                               Foreground="{DynamicResource TextQuaternary}"
                               FontSize="11" VerticalAlignment="Top" Margin="0,2,10,0"
                               IsVisible="{Binding ShowTimestamps}"/>
                    <StackPanel Spacing="6">
                        <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                             Foreground="{DynamicResource StatusErrorForeground}"/>
                        <Button Name="trustCertificateButton"
                                Content="{Binding TrustLabel}"
                                Command="{Binding TrustCommand}"
                                IsVisible="{Binding CanTrust}"
                                Padding="10,3" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- The stop after every entry point refused its certificate: an error block with the
             Reconnect button. It comes before the ErrorMessageViewModel template, which would
             match it too. -->
        <DataTemplate DataType="{x:Type vm:EveryEntryPointRefusedViewModel}">
            <Border Margin="12,3,12,3" Background="{DynamicResource StatusErrorBackground}"
                    CornerRadius="4" Padding="10,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Time, StringFormat='HH:mm'}"
                               Foreground="{DynamicResource TextQuaternary}"
                               FontSize="11" VerticalAlignment="Top" Margin="0,2,10,0"
                               IsVisible="{Binding ShowTimestamps}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource StatusErrorForeground}"/>
                        <Button Name="reconnectButton"
                                Content="{Binding ReconnectLabel}"
                                Command="{Binding ReconnectCommand}"
                                IsVisible="{Binding CanReconnect}"
                                Padding="10,3" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ErrorMessageViewModel}">
            <Border Margin="12,3,12,3" Background="{DynamicResource StatusErrorBackground}"
                    CornerRadius="4" Padding="10,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Time, StringFormat='HH:mm'}"
                               Foreground="{DynamicResource TextQuaternary}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                               IsVisible="{Binding ShowTimestamps}"/>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource StatusErrorForeground}"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WarningMessageViewModel}">
            <Border Margin="12,3,12,3" Background="{DynamicResource StatusWarningBackground}"
                    CornerRadius="4" Padding="10,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding Time, StringFormat='HH:mm'}"
                               Foreground="{DynamicResource TextQuaternary}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                               IsVisible="{Binding ShowTimestamps}"/>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource StatusWarningForeground}"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChatItemViewModel}">
            <DockPanel Margin="16,1,16,1">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Time, StringFormat='HH:mm'}"
                           Foreground="{DynamicResource TextQuaternary}"
                           FontSize="11" Width="40" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           IsVisible="{Binding ShowTimestamps}"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiary}"
                           FontStyle="Italic" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>

    </Application.DataTemplates>

</Application>
