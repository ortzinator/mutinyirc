<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ic="using:FluentIcons.Avalonia">

    <!-- Every clickable row in the sidebar wears this theme: the connections in the switcher's
         flyout, the console, the channels and the direct messages. A row is one button. The
         selection pill and the close affordance are parts of it, not siblings beside it, so a
         row has one hover state, one hit-test shape and one DataContext. -->
    <ControlTheme x:Key="SidebarNavTheme" TargetType="Button">
        <Setter Property="Background"                Value="Transparent"/>
        <Setter Property="Foreground"                Value="{DynamicResource TextTertiary}"/>
        <Setter Property="BorderThickness"           Value="0"/>
        <Setter Property="HorizontalAlignment"       Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment"  Value="Center"/>
        <Setter Property="CornerRadius"              Value="4"/>
        <Setter Property="Padding"                   Value="8,5"/>
        <Setter Property="Cursor"                    Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The pill and the close button overlay the row rather than taking columns of
                     their own, so a row that has neither is laid out identically to one that has
                     both. -->
                <Panel>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <!-- Hidden rather than transparent, so a row nobody points at cannot be
                         closed by a click on the empty space where its close button would be. -->
                    <Button Name="PART_Close"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="18" Height="18" Padding="0" Margin="0,0,4,0"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="3"
                            Foreground="{DynamicResource TextTertiary}"
                            IsVisible="False"
                            Command="{Binding CloseCommand}"
                            ToolTip.Tip="{Binding CloseTooltip}">
                        <ic:SymbolIcon Symbol="Dismiss" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Border Name="PART_Pill"
                            Width="3" Margin="0,6"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            IsVisible="False"
                            Background="{DynamicResource AccentFillBrush}"/>
                </Panel>
            </ControlTemplate>
        </Setter>
        <!-- Order matters: the last matching setter wins, so selected outranks hover and
             press outranks both. Listing press before active would make the selected item
             the one nav item that gives no feedback when you click it. -->
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBackground}"/>
        </Style>
        <Style Selector="^.active /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource SubtleSelectedBackground}"/>
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource SubtlePressBackground}"/>
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="^.active">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="^.active /template/ Border#PART_Pill">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- A closable row is one the user may dismiss: it keeps room on its right for the
             close button, which appears while the pointer is on the row. -->
        <Style Selector="^.closable">
            <Setter Property="Padding" Value="12,5,30,5"/>
        </Style>
        <Style Selector="^.closable:pointerover /template/ Button#PART_Close">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- Bold the nav item's text on unread. Set on the button so its content
             TextBlocks inherit FontWeight, the same way they inherit Foreground —
             a ControlTheme may not use a descendant selector to reach content. -->
        <Style Selector="^.unread">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </ControlTheme>

</ResourceDictionary>
