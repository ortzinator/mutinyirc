<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Sidebar -->
            <SolidColorBrush x:Key="SidebarBackground"            Color="#1E1F22" />
            <SolidColorBrush x:Key="SidebarBorderBrush"           Color="#2B2D31" />
            <SolidColorBrush x:Key="SidebarItemHoverBackground"    Color="#2E3035" />
            <SolidColorBrush x:Key="SidebarItemSelectedBackground" Color="#35373C" />
            <SolidColorBrush x:Key="SidebarForeground"             Color="#B5BAC1" />
            <SolidColorBrush x:Key="SidebarMutedForeground"        Color="#6D6F78" />
            <SolidColorBrush x:Key="SidebarHeaderForeground"       Color="#FFFFFF" />

            <!-- Channel header -->
            <SolidColorBrush x:Key="ChannelHeaderBackground"       Color="#2B2D31" />
            <SolidColorBrush x:Key="ChannelHeaderBorderBrush"      Color="#3A3C43" />

            <!-- Chat area -->
            <SolidColorBrush x:Key="AppBackground"                 Color="#313338" />
            <SolidColorBrush x:Key="ChatBorderBrush"               Color="#3A3C43" />

            <!-- Message input -->
            <SolidColorBrush x:Key="ChatInputAreaBackground"       Color="#383A40" />
            <SolidColorBrush x:Key="ChatInputBorderBrush"          Color="#222327" />

            <!-- Message text -->
            <SolidColorBrush x:Key="ChatTimestampForeground"       Color="#72767D" />
            <SolidColorBrush x:Key="SystemMessageForeground"       Color="#80848E" />
            <SolidColorBrush x:Key="ActionMessageForeground"       Color="#A8C8A0" />
            <SolidColorBrush x:Key="NoticeForeground"              Color="#FFEF8C" />
            <SolidColorBrush x:Key="ErrorForeground"               Color="#FF6B6B" />

            <!-- Message type backgrounds -->
            <SolidColorBrush x:Key="ChatTimestampBackground"       Color="Transparent" />
            <SolidColorBrush x:Key="ChatNickBackground"            Color="Transparent" />
            <SolidColorBrush x:Key="ChatErrorBackground"           Color="#3D1515" />
            <SolidColorBrush x:Key="ChatNoticeBackground"          Color="#2E2C1A" />
            <Color x:Key="ChatActionGradientStart">#00000000</Color>
            <Color x:Key="ChatActionGradientEnd">#00000000</Color>

            <!-- Scroll indicator -->
            <SolidColorBrush x:Key="ScrollIndicatorBackground"     Color="#3A3C43" />
            <SolidColorBrush x:Key="ScrollIndicatorForeground"     Color="#89FFFFFF" />

            <!-- User list: mode colours -->
            <SolidColorBrush x:Key="ModeOpForeground"              Color="#F1C40F" />
            <SolidColorBrush x:Key="ModeVoiceForeground"           Color="#57F287" />
            <SolidColorBrush x:Key="ModeRegularForeground"         Color="#B5BAC1" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Sidebar -->
            <SolidColorBrush x:Key="SidebarBackground"            Color="#F2F3F5" />
            <SolidColorBrush x:Key="SidebarBorderBrush"           Color="#E3E5E8" />
            <SolidColorBrush x:Key="SidebarItemHoverBackground"    Color="#E3E5E8" />
            <SolidColorBrush x:Key="SidebarItemSelectedBackground" Color="#D7D9DC" />
            <SolidColorBrush x:Key="SidebarForeground"             Color="#2C2F33" />
            <SolidColorBrush x:Key="SidebarMutedForeground"        Color="#868A92" />
            <SolidColorBrush x:Key="SidebarHeaderForeground"       Color="#060607" />

            <!-- Channel header -->
            <SolidColorBrush x:Key="ChannelHeaderBackground"       Color="#FFFFFF" />
            <SolidColorBrush x:Key="ChannelHeaderBorderBrush"      Color="#E3E5E8" />

            <!-- Chat area -->
            <SolidColorBrush x:Key="AppBackground"                 Color="#FFFFFF" />
            <SolidColorBrush x:Key="ChatBorderBrush"               Color="#E3E5E8" />

            <!-- Message input -->
            <SolidColorBrush x:Key="ChatInputAreaBackground"       Color="#EDEEF0" />
            <SolidColorBrush x:Key="ChatInputBorderBrush"          Color="#C7C9CF" />

            <!-- Message text -->
            <SolidColorBrush x:Key="ChatTimestampForeground"       Color="#A3A6AA" />
            <SolidColorBrush x:Key="SystemMessageForeground"       Color="#A3A6AA" />
            <SolidColorBrush x:Key="ActionMessageForeground"       Color="#2D6A1E" />
            <SolidColorBrush x:Key="NoticeForeground"              Color="#7A5800" />
            <SolidColorBrush x:Key="ErrorForeground"               Color="#C0392B" />

            <!-- Message type backgrounds -->
            <SolidColorBrush x:Key="ChatTimestampBackground"       Color="Transparent" />
            <SolidColorBrush x:Key="ChatNickBackground"            Color="Transparent" />
            <SolidColorBrush x:Key="ChatErrorBackground"           Color="#FDEAEA" />
            <SolidColorBrush x:Key="ChatNoticeBackground"          Color="#FFFCDC" />
            <Color x:Key="ChatActionGradientStart">#00000000</Color>
            <Color x:Key="ChatActionGradientEnd">#00000000</Color>

            <!-- Scroll indicator -->
            <SolidColorBrush x:Key="ScrollIndicatorBackground"     Color="#E3E5E8" />
            <SolidColorBrush x:Key="ScrollIndicatorForeground"     Color="#89000000" />

            <!-- User list: mode colours -->
            <SolidColorBrush x:Key="ModeOpForeground"              Color="#8B5A00" />
            <SolidColorBrush x:Key="ModeVoiceForeground"           Color="#1A7A42" />
            <SolidColorBrush x:Key="ModeRegularForeground"         Color="#444444" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Padding for the header strip of a content panel. The client area is extended
         into the window decorations, so the caption buttons float over the top-right
         corner of whichever panel is showing. The right inset keeps header content
         clear of them. -->
    <Thickness x:Key="PanelHeaderPadding">16,0,148,0</Thickness>

</ResourceDictionary>
