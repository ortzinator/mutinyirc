<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <!-- Main application background -->
            <SolidColorBrush x:Key="AppBackground" Color="#FF252525" />

            <!-- Chat line: timestamp column -->
            <SolidColorBrush x:Key="ChatTimestampBackground" Color="#FF2D2D2D" />

            <!-- Chat line: borders between cells -->
            <SolidColorBrush x:Key="ChatBorderBrush" Color="#FF3D3D3D" />

            <!-- Chat line: nick column in channel messages -->
            <SolidColorBrush x:Key="ChatNickBackground" Color="#FF1A3F6E" />

            <!-- Chat line: action message gradient start/end -->
            <Color x:Key="ChatActionGradientStart">#FF1A3F6E</Color>
            <Color x:Key="ChatActionGradientEnd">#FF252525</Color>

            <!-- Chat line: error and warning messages -->
            <SolidColorBrush x:Key="ChatErrorBackground" Color="#FF4A1E1E" />

            <!-- Chat line: private notice background -->
            <SolidColorBrush x:Key="ChatNoticeBackground" Color="#FF3A3A1E" />

            <!-- Scroll indicator bar (shown when not pinned to bottom) -->
            <SolidColorBrush x:Key="ScrollIndicatorBackground" Color="#FF3D3D3D" />
            <SolidColorBrush x:Key="ScrollIndicatorForeground" Color="#89FFFFFF" />

            <!-- User list: ops are white to stand out; voice and regular are grey -->
            <SolidColorBrush x:Key="ModeOpForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ModeVoiceForeground" Color="#FFCCCCCC" />
            <SolidColorBrush x:Key="ModeRegularForeground" Color="#FFCCCCCC" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Main application background -->
            <SolidColorBrush x:Key="AppBackground" Color="#FFF3F3F3" />

            <!-- Chat line: timestamp column -->
            <SolidColorBrush x:Key="ChatTimestampBackground" Color="#FFE8E8E8" />

            <!-- Chat line: borders between cells -->
            <SolidColorBrush x:Key="ChatBorderBrush" Color="#FFCCCCCC" />

            <!-- Chat line: nick column in channel messages -->
            <SolidColorBrush x:Key="ChatNickBackground" Color="#FFD0E8FF" />

            <!-- Chat line: action message gradient start/end -->
            <Color x:Key="ChatActionGradientStart">#FFD0E8FF</Color>
            <Color x:Key="ChatActionGradientEnd">#FFF3F3F3</Color>

            <!-- Chat line: error and warning messages -->
            <SolidColorBrush x:Key="ChatErrorBackground" Color="#FFFFDDDD" />

            <!-- Chat line: private notice background -->
            <SolidColorBrush x:Key="ChatNoticeBackground" Color="#FFFFFACC" />

            <!-- Scroll indicator bar (shown when not pinned to bottom) -->
            <SolidColorBrush x:Key="ScrollIndicatorBackground" Color="#FFCCCCCC" />
            <SolidColorBrush x:Key="ScrollIndicatorForeground" Color="#89000000" />

            <!-- User list: foreground by channel mode -->
            <SolidColorBrush x:Key="ModeOpForeground" Color="#FF8B6200" />
            <SolidColorBrush x:Key="ModeVoiceForeground" Color="#FF1A5FA8" />
            <SolidColorBrush x:Key="ModeRegularForeground" Color="#FF444444" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
