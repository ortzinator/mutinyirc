<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OrtzIRC.Avalonia.Controls"
             xmlns:views="clr-namespace:OrtzIRC.Avalonia.Views"
             xmlns:vm="clr-namespace:OrtzIRC.Avalonia.ViewModels"
             mc:Ignorable="d"
             x:Class="OrtzIRC.Avalonia.Views.ServerView">

    <Design.DataContext>
        <vm:ServerViewModel />
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource ChatBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8">
            <DockPanel>
                <Button x:Name="sendButton" DockPanel.Dock="Right" Content="Send" Padding="12,6" />
                <local:CommandTextBox x:Name="commandBox" BorderThickness="0" PlaceholderText="Write a message" MinHeight="20" />
            </DockPanel>
        </Border>
        <views:IrcOutputBox x:Name="outputBox" />
    </DockPanel>

</UserControl>
